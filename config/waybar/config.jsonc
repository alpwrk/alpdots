// One entry per monitor. Waybar builds a separate bar for each output and the
// brightness module gets the output name as a fixed argument, because
// on-scroll-* handlers never receive WAYBAR_OUTPUT_NAME (only exec does).
// Shared settings live in config.common.jsonc and are pulled in via include;
// keys defined here win over the included ones. local.jsonc is included first
// so it wins over config.common.jsonc; install.sh writes it on laptops to fill
// group/laptop with the battery module. It's gitignored.
//
// The brightness module updates optimistically: scrolling only bumps a cache
// and signals this bar's own RT signal, so the label changes instantly and
// only the matching monitor redraws. exec-on-event is off to avoid the exec /
// scroll race; the slow panel write runs in a detached applier.
[
  {
    "include": ["local.jsonc", "config.common.jsonc"],
    "output": "HDMI-A-1",
    "modules-right": [
      "group/traydrawer",
      "pulseaudio",
      "custom/brightness-hdmi",
      "mpris",
      "group/laptop"
    ],
    "custom/brightness-hdmi": {
      "exec": "~/.config/waybar/brightness.sh HDMI-A-1",
      "return-type": "json",
      "signal": 9,
      "exec-on-event": false,
      "on-scroll-up": "~/.config/waybar/brightness.sh HDMI-A-1 up",
      "on-scroll-down": "~/.config/waybar/brightness.sh HDMI-A-1 down",
      "tooltip": true
    }
  },
  {
    "include": ["local.jsonc", "config.common.jsonc"],
    "output": "DP-1",
    "modules-right": [
      "group/traydrawer",
      "pulseaudio",
      "custom/brightness-dp",
      "mpris",
      "group/laptop"
    ],
    "custom/brightness-dp": {
      "exec": "~/.config/waybar/brightness.sh DP-1",
      "return-type": "json",
      "signal": 11,
      "exec-on-event": false,
      "on-scroll-up": "~/.config/waybar/brightness.sh DP-1 up",
      "on-scroll-down": "~/.config/waybar/brightness.sh DP-1 down",
      "tooltip": true
    }
  },
  {
    // Every other output (laptop panel, other monitors): no DDC brightness
    "include": ["local.jsonc", "config.common.jsonc"],
    "output": ["!HDMI-A-1", "!DP-1", "*"],
    "modules-right": [
      "group/traydrawer",
      "pulseaudio",
      "mpris",
      "group/laptop"
    ]
  }
]
