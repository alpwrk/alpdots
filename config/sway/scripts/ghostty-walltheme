#!/usr/bin/env python3
"""Generate a Ghostty color theme from the current wallpaper.

Accent colors are extracted from the image and mapped onto the 16 ANSI
slots by hue (red stays reddish, green greenish, ...). Every text color is
then brightened until it meets a WCAG contrast minimum against the
*effective* background: the terminal background blended with the brightest
part of the wallpaper, because the window is translucent (opacity + blur).

Usage: ghostty-walltheme [IMAGE] [--print] [--no-reload]
Without IMAGE the wallpaper from ~/.cache/bgswitch/current is used.
Writes ~/.config/ghostty/auto/theme.ghostty and sends SIGUSR2 to Ghostty
so open windows reload their config.
"""

import math
import os
import subprocess
import sys

from PIL import Image

CURRENT = os.path.expanduser("~/.cache/bgswitch/current")
OUT = os.path.expanduser("~/.config/ghostty/auto/theme.ghostty")
OPACITY = 0.35  # must match background-opacity in config.ghostty
MAX_OPACITY = 0.55  # bright wallpapers never get more opaque than this

# Contrast minimums (WCAG ratio) against the effective background
MIN_FG = 5.5       # main text
MIN_COLOR = 4.5    # ANSI colors 1-7 (AA)
MIN_BRIGHT = 5.5   # ANSI colors 9-15
MIN_DIM = 3.0      # ANSI 8 (comments, autosuggestions)
MIN_CURSOR = 3.0

# OKLCH target hues of the ANSI slots: red, green, yellow, blue, magenta, cyan
SLOTS = {1: 27, 2: 145, 3: 95, 4: 262, 5: 330, 6: 200}
SLOT_CAPTURE = 40  # an accent within this many degrees takes over the slot
SLOT_CLAMP = 22    # but its hue may drift at most this far from the slot hue
SLOT_PULL = 0.25   # other slots lean this much toward the main accent hue


# --- color math -----------------------------------------------------------

def srgb_to_lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def lin_to_srgb(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def rgb_to_oklab(rgb):
    r, g, b = (srgb_to_lin(c) for c in rgb)
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def oklab_to_lin(lab):
    L, a, b = lab
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def to_oklch(rgb):
    L, a, b = rgb_to_oklab(rgb)
    return L, math.hypot(a, b), math.degrees(math.atan2(b, a)) % 360


def from_oklch(L, C, h):
    """OKLCH -> sRGB (0..1), reducing chroma until the color is in gamut."""
    L = min(1.0, max(0.0, L))
    for _ in range(40):
        a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
        lin = oklab_to_lin((L, a, b))
        if all(-1e-4 <= c <= 1 + 1e-4 for c in lin):
            break
        C *= 0.9
    return tuple(min(1.0, max(0.0, lin_to_srgb(min(1.0, max(0.0, c))))) for c in lin)


def luminance(rgb):
    r, g, b = (srgb_to_lin(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(x, y):
    a, b = luminance(x), luminance(y)
    return (max(a, b) + 0.05) / (min(a, b) + 0.05)


def to_hex(rgb):
    return "#{:02x}{:02x}{:02x}".format(*(round(c * 255) for c in rgb))


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


def lift(L, C, h, against, minimum, step=0.01):
    """Move lightness away from the background until contrast >= minimum.

    step > 0 brightens (light text), step < 0 darkens (dark text). Chroma
    is reduced near white/black, where saturated colors fall out of gamut."""
    rgb = from_oklch(L, C, h)
    while contrast(rgb, against) < minimum and 0.0 < L < 1.0:
        L += step
        if L > 0.85 or L < 0.25:
            C *= 0.94
        rgb = from_oklch(L, C, h)
    return rgb


# --- image analysis -------------------------------------------------------

def analyze(path):
    """Return (accents, base_hue, base_chroma, bright_rgb, mean_rgb).

    accents: list of (hue, chroma) sorted by weight, strongest first."""
    img = Image.open(path).convert("RGB")
    img.thumbnail((96, 96), Image.Resampling.BOX)
    data = img.get_flattened_data() if hasattr(img, "get_flattened_data") else img.getdata()
    px = [tuple(c / 255 for c in p) for p in data]
    lch = [to_oklch(p) for p in px]

    bins = [[] for _ in range(24)]
    for L, C, h in lch:
        if C > 0.04 and 0.25 < L < 0.97:
            bins[int(h / 15) % 24].append((C * L, h, C))
    total = sum(len(b) for b in bins)

    accents = []
    for b in sorted(bins, key=lambda b: -sum(t[0] for t in b)):
        if not b or len(b) < max(3, total * 0.03):
            break
        w = sum(t[0] for t in b)
        hx = sum(t[0] * math.cos(math.radians(t[1])) for t in b) / w
        hy = sum(t[0] * math.sin(math.radians(t[1])) for t in b) / w
        hue = math.degrees(math.atan2(hy, hx)) % 360
        chroma = sum(t[0] * t[2] for t in b) / w
        # merge with an existing accent of nearly the same hue
        if any(hue_dist(hue, a[0]) < 20 for a in accents):
            continue
        accents.append((hue, chroma))
        if len(accents) == 6:
            break

    # Base tone: average of the darker half (sets the background tint)
    order = sorted(range(len(px)), key=lambda i: lch[i][0])
    dark = [lch[i] for i in order[: len(order) // 2]]
    bx = sum(c * math.cos(math.radians(h)) for _, c, h in dark)
    by = sum(c * math.sin(math.radians(h)) for _, c, h in dark)
    base_hue = math.degrees(math.atan2(by, bx)) % 360
    base_chroma = math.hypot(bx, by) / len(dark)

    # Worst case shining through: average of the brightest 25 % (blur averages it out)
    top = [px[i] for i in order[-max(1, len(order) // 4):]]
    bright = tuple(sum(p[c] for p in top) / len(top) for c in range(3))
    # Average tone: what a fully transparent, blurred window shows on average
    mean = tuple(sum(p[c] for p in px) / len(px) for c in range(3))
    return accents, base_hue, base_chroma, bright, mean


# --- theme ------------------------------------------------------------------

def build(path):
    accents, base_hue, base_chroma, bright, mean = analyze(path)
    main_hue, main_chroma = accents[0] if accents else (base_hue, 0.0)
    accent_chroma = max(0.08, min(0.16, main_chroma)) if accents else 0.10

    # Background: dark, slightly tinted with the image's base tone
    bg = from_oklch(0.13, min(0.035, base_chroma), base_hue)
    opacity = OPACITY

    def effective(op):
        return tuple(op * b + (1 - op) * w for b, w in zip(bg, bright))

    if opacity == 0:
        # Fully transparent: the wallpaper itself is the background. Use its
        # average tone and pick dark or light text, whichever reads better.
        eff = mean
        bg = mean  # also lets Ghostty's minimum-contrast work against it
    else:
        # Bright wallpapers: get more opaque until the effective bg stays dark
        while luminance(effective(opacity)) > 0.11 and opacity < MAX_OPACITY:
            opacity = round(opacity + 0.01, 2)
        eff = effective(opacity)
    # With a dark tint the text must stay light; only a fully clear window can flip
    dark = opacity == 0 and contrast((0, 0, 0), eff) > contrast((1, 1, 1), eff)
    step = -0.01 if dark else 0.01

    def L(light_value):
        """Start lightness for a color; mirrored for dark text."""
        return 1.12 - light_value if dark else light_value

    tint = min(0.025, accent_chroma / 4) if accents else 0.0
    fg = lift(L(0.93), tint, main_hue, eff, MIN_FG, step)

    pal = {}
    for slot, target in SLOTS.items():
        near = [a for a in accents if hue_dist(a[0], target) < SLOT_CAPTURE]
        if near:
            h, c = min(near, key=lambda a: hue_dist(a[0], target))
            # keep the accent's hue but don't let it drift too far from the slot
            d = ((h - target + 180) % 360) - 180
            h = (target + max(-SLOT_CLAMP, min(SLOT_CLAMP, d))) % 360
            c = max(0.09, min(0.17, c))
        elif accents:
            # no matching accent: lean toward the wallpaper's main hue
            d = ((main_hue - target + 180) % 360) - 180
            h = (target + max(-SLOT_CLAMP, min(SLOT_CLAMP, d * SLOT_PULL))) % 360
            c = accent_chroma
        else:
            h, c = target, accent_chroma
        pal[slot] = lift(L(0.72), c, h, eff, MIN_COLOR, step)
        pal[slot + 8] = lift(L(0.80), c * 1.05, h, eff, MIN_BRIGHT, step)

    pal[0] = from_oklch(L(0.27) if not dark else 0.25, min(0.03, base_chroma), base_hue)
    pal[8] = lift(L(0.58), tint, main_hue, eff, MIN_DIM, step)
    pal[7] = lift(L(0.82), tint * 0.6, main_hue, eff, MIN_FG - 1, step)
    pal[15] = fg

    accent_c = accent_chroma if accents else 0.0
    cursor = lift(L(0.80), accent_c, main_hue, eff, MIN_CURSOR, step)
    sel_bg = from_oklch(0.40 if not dark else 0.80, min(0.09, accent_c), main_hue)
    sel_fg = fg if contrast(fg, sel_bg) >= MIN_COLOR else (
        (0.0, 0.0, 0.0) if dark else (1.0, 1.0, 1.0))

    return {
        "bg": bg, "fg": fg, "pal": pal, "cursor": cursor,
        "sel_bg": sel_bg, "sel_fg": sel_fg, "eff": eff,
        "opacity": opacity, "accents": accents, "dark": dark,
    }


def render(path, t):
    lines = [
        "# Generated by ghostty-walltheme (bgswitch) - do not edit.",
        f"# Wallpaper: {path}",
        f"background = {to_hex(t['bg'])}",
        f"foreground = {to_hex(t['fg'])}",
        f"cursor-color = {to_hex(t['cursor'])}",
        f"cursor-text = {to_hex(t['bg'])}",
        f"selection-background = {to_hex(t['sel_bg'])}",
        f"selection-foreground = {to_hex(t['sel_fg'])}",
    ]
    lines += [f"palette = {i}={to_hex(t['pal'][i])}" for i in range(16)]
    if t["opacity"] != OPACITY:
        lines.append(f"background-opacity = {t['opacity']}")
    # Safety net for 24-bit colors from apps that ignore the palette
    lines.append("minimum-contrast = 3")
    return "\n".join(lines) + "\n"


def report(path, t):
    def sw(rgb):
        r, g, b = (round(c * 255) for c in rgb)
        return f"\x1b[48;2;{r};{g};{b}m    \x1b[0m"

    eff = t["eff"]
    print(f"{path}\n  accents: " + " ".join(f"{h:.0f}°/{c:.2f}" for h, c in t["accents"]))
    print(f"  bg {to_hex(t['bg'])}  effective {to_hex(eff)}  opacity {t['opacity']}"
          f"  text {'dark' if t['dark'] else 'light'}")
    rows = [("fg", t["fg"], MIN_FG), ("cursor", t["cursor"], MIN_CURSOR)]
    rows += [(f"color{i}", t["pal"][i],
              MIN_DIM if i == 8 else MIN_BRIGHT if i > 8 else MIN_COLOR)
             for i in range(1, 16)]
    ok = True
    for name, rgb, need in rows:
        c = contrast(rgb, eff)
        flag = "ok" if c >= need else "LOW"
        ok &= c >= need
        print(f"  {sw(rgb)} {name:8} {to_hex(rgb)}  {c:5.2f} (>= {need})  {flag}")
    return ok


def write_if_changed(path, content):
    try:
        with open(path) as f:
            if f.read() == content:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.replace(tmp, path)
    return True


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    path = os.path.realpath(args[0] if args else CURRENT)
    if not os.path.exists(path):
        sys.exit(f"ghostty-walltheme: no wallpaper at {path}")
    theme = build(path)
    if "--print" in argv:
        return 0 if report(path, theme) else 1
    if write_if_changed(OUT, render(path, theme)) and "--no-reload" not in argv:
        subprocess.run(["pkill", "-USR2", "-x", "ghostty"], stdout=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
