#!/usr/bin/env python3
# Alt-Tab style wallpaper switcher for sway (GTK4 + layer-shell).
#
# Big preview on top, thumbnail strip below. Browsing sets the wallpaper
# live, and the accent color is taken from the image.
# Below that is a color row for the waybar background: transparent, the
# 3 accent colors of the selected wallpaper and 10 standard colors.
#
# Keys: Up/Down, k/j      = switch between the wallpaper strip and the color row
#       Left/Right, h/l, Tab = select in the active row
#       Enter             = set the wallpaper and close
#                           (in the color row: set the waybar color, stays open)
#       Esc               = close (an unconfirmed wallpaper is reverted)
#       AltGr+# again     = next wallpaper
# Wallpapers come from ~/.config/sway/wallpaper and $BGSWITCH_DIR
# (default ~/Pictures/wallpapers). The chosen one is symlinked to
# ~/.cache/bgswitch/current, which the sway config points at, so it
# survives a reload.

import os
import sys

# gtk4-layer-shell has to be loaded before libwayland, otherwise you get a
# normal window instead of an overlay.
# /usr/local/lib is where FreeBSD puts it.
LS_LIB = next(
    (p for p in ("/usr/lib/libgtk4-layer-shell.so", "/usr/local/lib/libgtk4-layer-shell.so",
                 "/usr/lib64/libgtk4-layer-shell.so") if os.path.exists(p)),
    None,
)
if LS_LIB and LS_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (LS_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    # cairo instead of gl/vulkan: the GL renderer on Nvidia let old frames show
    # through (ghost text/lines behind the panel), Vulkan spams warnings.
    os.environ.setdefault("GSK_RENDERER", "cairo")
    os.execv(sys.executable, [sys.executable] + sys.argv)

import colorsys
import math
import hashlib
import subprocess

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

WALL_DIRS = [
    os.path.expanduser("~/.config/sway/wallpaper"),
    os.path.expanduser(os.environ.get("BGSWITCH_DIR", "~/Pictures/wallpapers")),
]
CACHE = os.path.expanduser("~/.cache/bgswitch")
CURRENT = os.path.join(CACHE, "current")
PREVIEW_W, PREVIEW_H = 960, 540
STRIP_W, STRIP_H = 112, 63
EXTS = (".png", ".jpg", ".jpeg", ".webp")
PREVIEW_DELAY_MS = 120  # debounce before the wallpaper is set live
FALLBACK_ACCENT = "#ffffff"
WAYBAR_COLORS = os.path.expanduser("~/.config/waybar/accent.css")
SWATCH_W, SWATCH_H = 40, 24
STANDARD_COLORS = [
    ("Black", "#000000"), ("White", "#ffffff"), ("Grey", "#3a3a3a"),
    ("Red", "#e06c75"), ("Orange", "#e5a050"), ("Yellow", "#e5c07b"),
    ("Green", "#98c379"), ("Cyan", "#56b6c2"), ("Blue", "#61afef"),
    ("Purple", "#c678dd"),
]

# Base palette like rofi/mono.rasi, the accent comes in dynamically via @accent
CSS = """
@define-color accent #ffffff;
window { background: transparent; }
.panel {
    background: rgba(13,13,13,0.85);
    border: 2px solid alpha(@accent, 0.45);
    border-radius: 2px;
    padding: 16px;
    transition: border-color 150ms ease-out;
}
.preview {
    border: 2px solid alpha(@accent, 0.8);
    border-radius: 2px;
    transition: border-color 150ms ease-out;
}
.strip { margin-top: 12px; }
.thumb {
    padding: 2px;
    border: 2px solid transparent;
    border-radius: 2px;
    opacity: 0.55;
    transition: border-color 150ms ease-out, opacity 150ms ease-out;
}
.thumb:hover { opacity: 0.85; }
.thumb.current { border-bottom-color: #6a6a6a; }
.thumb.selected { border-color: @accent; background: #1f1f1f; opacity: 1; }
.strip.inactive .thumb.selected { border-color: alpha(@accent, 0.35); }
.colors { margin-top: 10px; }
.swatch {
    padding: 2px;
    border: 2px solid transparent;
    border-radius: 2px;
    transition: border-color 150ms ease-out;
}
.swatch.current { border-bottom-color: #8a8a8a; }
.colors:not(.inactive) .swatch.selected { border-color: @accent; background: #1f1f1f; }
.colors separator { background: #2b2b2b; min-width: 2px; margin: 4px 8px; }
.title {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 10pt;
    color: #e6e6e6;
    margin-top: 10px;
}
.title .icon { color: @accent; }
"""


def thumbnail(path, w, h):
    """Cached image cropped to w x h, regenerated when the original is newer."""
    key = hashlib.sha1(f"{path}|{w}x{h}".encode()).hexdigest()
    thumb = os.path.join(CACHE, "thumbs", key + ".png")
    if not os.path.exists(thumb) or os.path.getmtime(thumb) < os.path.getmtime(path):
        os.makedirs(os.path.dirname(thumb), exist_ok=True)
        src = GdkPixbuf.Pixbuf.new_from_file(path)
        # "fill": scale to the target size and crop centered
        scale = max(w / src.get_width(), h / src.get_height())
        sw, sh = round(src.get_width() * scale), round(src.get_height() * scale)
        scaled = src.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
        scaled.new_subpixbuf((sw - w) // 2, (sh - h) // 2, w, h).savev(thumb, "png", [], [])
    return thumb


def to_hex(r, g, b):
    return "#{:02x}{:02x}{:02x}".format(*(round(min(1, max(0, c)) * 255) for c in (r, g, b)))


def palette(thumb_path):
    """(UI accent, [3 accent colors]) from the image.

    Colorful pixels are sorted into 12 hue buckets, the strongest buckets
    give the accents. If there isn't enough color, the list is filled up
    with the dark/mid/light base tone of the image. The UI accent is the
    first hue, brightened, or white for grey images."""
    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(thumb_path, 32, 18, False)
    data, stride, nch = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
    bins = [[] for _ in range(12)]
    allpx = []
    for y in range(pb.get_height()):
        for x in range(pb.get_width()):
            o = y * stride + x * nch
            rgb = (data[o] / 255, data[o + 1] / 255, data[o + 2] / 255)
            hh, s, v = colorsys.rgb_to_hsv(*rgb)
            allpx.append((v, rgb))
            if s > 0.25 and 0.2 < v < 0.98:
                bins[int(hh * 12) % 12].append((s * v, hh, s, v))

    total = sum(len(b) for b in bins)
    hues = []
    for b in sorted(bins, key=lambda b: -sum(t[0] for t in b)):
        if len(b) < max(3, total * 0.04):
            break
        wsum = sum(t[0] for t in b)
        hx = sum(t[0] * math.cos(t[1] * 2 * math.pi) for t in b) / wsum
        hy = sum(t[0] * math.sin(t[1] * 2 * math.pi) for t in b) / wsum
        hue = (math.atan2(hy, hx) / (2 * math.pi)) % 1.0
        sat = sum(t[0] * t[2] for t in b) / wsum
        val = sum(t[0] * t[3] for t in b) / wsum
        hues.append((hue, sat, val))

    ui = FALLBACK_ACCENT
    if hues:
        h, sa, v = hues[0]
        ui = to_hex(*colorsys.hsv_to_rgb(h, min(0.85, sa), max(0.8, v)))

    cands = [to_hex(*colorsys.hsv_to_rgb(h, min(0.85, sa), max(0.55, v))) for h, sa, v in hues]
    # Fill up with base tones: average of the dark, mid and light third
    allpx.sort(key=lambda t: t[0])
    n = len(allpx)
    for part in (allpx[: n // 3], allpx[n // 3: 2 * n // 3], allpx[2 * n // 3:]):
        cands.append(to_hex(*(sum(p[1][c] for p in part) / len(part) for c in range(3))))

    def dist(x, y):
        return sum(abs(int(x[i:i + 2], 16) - int(y[i:i + 2], 16)) for i in (1, 3, 5))

    out = []
    for c in cands:
        if all(dist(c, o) > 48 for o in out):
            out.append(c)
        if len(out) == 3:
            break
    while len(out) < 3:
        out.append(cands[-1])
    return ui, out


def current_wallpaper():
    try:
        path = os.path.realpath(CURRENT)
        return path if os.path.exists(path) else None
    except OSError:
        return None


def preview_wallpaper(path):
    """Only show it, the symlink stays unchanged."""
    subprocess.Popen(["swaymsg", "output", "*", "bg", path, "fill"], stdout=subprocess.DEVNULL)


def set_wallpaper(path):
    os.makedirs(CACHE, exist_ok=True)
    tmp = CURRENT + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(path, tmp)
    os.replace(tmp, CURRENT)
    preview_wallpaper(path)


def contrast_text(hexcolor):
    """Black or white, whichever reads better on hexcolor (WCAG)."""
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (int(hexcolor[i:i + 2], 16) for i in (1, 3, 5))
    lum = 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
    return "#000000" if (lum + 0.05) / 0.05 > 1.05 / (lum + 0.05) else "#ffffff"


def write_if_changed(path, content):
    """Write atomically; True if something changed."""
    try:
        with open(path) as f:
            if f.read() == content:
                return False
    except OSError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.replace(tmp, path)
    return True


def current_waybar_color():
    try:
        with open(WAYBAR_COLORS) as f:
            for line in f:
                if line.startswith("@define-color background "):
                    return line.split()[2].rstrip(";")
    except OSError:
        pass
    return None


def set_waybar_color(color):
    """color = "#rrggbb" or "transparent"; text black/white by contrast."""
    if color == "transparent":
        bg, fg, inv = "transparent", "#ffffff", "#000000"
    else:
        bg, fg, inv = color, contrast_text(color), color  # inv = text in the focused workspace box
    css = (
        "/* Generated by bgswitch (waybar color row), not tracked by git. */\n"
        f"@define-color background {bg};\n"
        f"@define-color foreground {fg};\n"
        f"@define-color inverted {inv};\n"
    )
    os.makedirs(os.path.dirname(WAYBAR_COLORS), exist_ok=True)
    if write_if_changed(WAYBAR_COLORS, css):
        # reload_style_on_change only watches style.css, so reload explicitly
        subprocess.run(["pkill", "-USR2", "-x", "waybar"], stdout=subprocess.DEVNULL)


class Switcher(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="de.alpwrk.bgswitch")
        self.win = None

    def do_activate(self):
        # Second launch (AltGr+# again) -> step forward like Alt+Tab
        if self.win:
            self.focus_row(0)
            self.move(1)
            return

        # Same file name in both dirs: the first dir wins
        found = {}
        for d in WALL_DIRS:
            if not os.path.isdir(d):
                continue
            for f in os.listdir(d):
                if f.lower().endswith(EXTS) and f not in found:
                    found[f] = os.path.join(d, f)
        self.walls = [found[f] for f in sorted(found, key=str.lower)]
        if not self.walls:
            self.quit()
            return

        self.original = current_wallpaper()
        self.shown = self.original  # what sway is showing right now
        self.preview_timer = 0
        self.previews = {}
        self.palettes = {}  # path -> (UI accent, [3 accents])
        self.strip_thumbs = []
        self.row_idx = 0  # 0 = wallpaper strip, 1 = color row

        display = Gdk.Display.get_default()
        base = Gtk.CssProvider()
        base.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(display, base, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.accent_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            display, self.accent_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1
        )

        self.win = Gtk.ApplicationWindow(application=self)
        LayerShell.init_for_window(self.win)
        LayerShell.set_layer(self.win, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(self.win, LayerShell.KeyboardMode.EXCLUSIVE)
        LayerShell.set_namespace(self.win, "bgswitch")

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["panel"])

        self.preview = Gtk.Picture(css_classes=["preview"], can_shrink=False)
        self.preview.set_size_request(PREVIEW_W, PREVIEW_H)
        panel.append(self.preview)

        row = Gtk.Box(spacing=6)
        cur = self.original
        self.items = []
        for path in self.walls:
            thumb = thumbnail(path, STRIP_W, STRIP_H)
            self.strip_thumbs.append(thumb)
            box = Gtk.Box(css_classes=["thumb"])
            pic = Gtk.Picture.new_for_paintable(Gdk.Texture.new_from_filename(thumb))
            pic.set_size_request(STRIP_W, STRIP_H)
            pic.set_can_shrink(False)
            box.append(pic)
            box.set_tooltip_text(os.path.basename(path))
            if path == cur:
                box.add_css_class("current")
            click = Gtk.GestureClick()
            click.connect("released", lambda *_, i=len(self.items): self.apply(i))
            box.add_controller(click)
            row.append(box)
            self.items.append(box)
        self.row = row

        self.scroller = Gtk.ScrolledWindow(
            child=row,
            css_classes=["strip"],
            vscrollbar_policy=Gtk.PolicyType.NEVER,
            hscrollbar_policy=Gtk.PolicyType.EXTERNAL,
            propagate_natural_height=True,
        )
        self.scroller.set_size_request(PREVIEW_W, -1)
        panel.append(self.scroller)

        # Color row: transparent | 3 accents of the selected wallpaper | standard colors
        self.colors = Gtk.Box(spacing=4, css_classes=["colors", "inactive"], halign=Gtk.Align.CENTER)
        self.swatch_colors = ["transparent", "#000000", "#000000", "#000000"]
        self.swatch_colors += [c for _, c in STANDARD_COLORS]
        self.swatch_names = ["Transparent", "Accent 1", "Accent 2", "Accent 3"]
        self.swatch_names += [n for n, _ in STANDARD_COLORS]
        self.swatches = []
        for i, _ in enumerate(self.swatch_colors):
            if i in (1, 4):
                self.colors.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
            area = Gtk.DrawingArea(content_width=SWATCH_W, content_height=SWATCH_H)
            area.set_draw_func(self.draw_swatch, i)
            box = Gtk.Box(css_classes=["swatch"])
            box.append(area)
            click = Gtk.GestureClick()
            click.connect("released", lambda *_, i=i: self.click_swatch(i))
            box.add_controller(click)
            self.colors.append(box)
            self.swatches.append(box)
        self.csel = 0
        self.swatches[0].add_css_class("selected")
        panel.append(self.colors)

        title = Gtk.Box(css_classes=["title"], halign=Gtk.Align.CENTER, spacing=10)
        title.append(Gtk.Label(label="󰸉", css_classes=["icon"]))
        self.title = Gtk.Label(ellipsize=3, max_width_chars=80)
        title.append(self.title)
        panel.append(title)

        self.win.set_child(panel)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.win.add_controller(keys)

        # Like Alt+Tab: start on the next entry right away
        start = self.walls.index(cur) if cur in self.walls else -1
        self.sel = 0
        self.select((start + 1) % len(self.items))
        self.win.present()
        # Scroll again after the first layout, there are no positions before that
        GLib.idle_add(lambda: self.scroll_to(self.sel) and False)

    # --- Selection --------------------------------------------------------

    def select(self, i):
        self.items[self.sel].remove_css_class("selected")
        self.sel = i
        self.items[i].add_css_class("selected")
        path = self.walls[i]

        if path not in self.previews:
            self.previews[path] = Gdk.Texture.new_from_filename(thumbnail(path, PREVIEW_W, PREVIEW_H))
        self.preview.set_paintable(self.previews[path])

        if path not in self.palettes:
            try:
                self.palettes[path] = palette(self.strip_thumbs[i])
            except GLib.Error:
                self.palettes[path] = (FALLBACK_ACCENT, ["#000000"] * 3)
        ui, accents = self.palettes[path]
        self.accent_css.load_from_string(f"@define-color accent {ui};")
        self.swatch_colors[1:4] = accents
        for sw in self.swatches[1:4]:
            sw.get_first_child().queue_draw()
        self.mark_current_color()
        self.update_title()

        self.scroll_to(i)
        self.schedule_live_preview()

    def scroll_to(self, i):
        """Scroll the selected thumbnail into the visible part of the strip."""
        ok, rect = self.items[i].compute_bounds(self.row)
        if not ok or rect.get_width() == 0:
            return True
        adj = self.scroller.get_hadjustment()
        x, w = rect.get_x(), rect.get_width()
        if x < adj.get_value():
            adj.set_value(x)
        elif x + w > adj.get_value() + adj.get_page_size():
            adj.set_value(x + w - adj.get_page_size())
        return True

    def move(self, d):
        if self.row_idx == 0:
            self.select((self.sel + d) % len(self.items))
        else:
            self.select_color((self.csel + d) % len(self.swatches))

    def focus_row(self, r):
        self.row_idx = r
        for widget, active in ((self.scroller, r == 0), (self.colors, r == 1)):
            if active:
                widget.remove_css_class("inactive")
            else:
                widget.add_css_class("inactive")
        self.update_title()

    def update_title(self):
        if self.row_idx == 0:
            path = self.walls[self.sel]
            self.title.set_label(f"{os.path.basename(path)}   [{self.sel + 1}/{len(self.items)}]")
        else:
            c = self.swatch_colors[self.csel]
            label = self.swatch_names[self.csel]
            if c != "transparent":
                label += f"  {c}"
            self.title.set_label(f"waybar: {label}   [Enter = set]")

    # --- Color row --------------------------------------------------------

    def draw_swatch(self, _area, cr, w, h, i):
        c = self.swatch_colors[i]
        if c == "transparent":
            # checkerboard
            sq = 6
            for yy in range(0, h, sq):
                for xx in range(0, w, sq):
                    g = 0.35 if (xx // sq + yy // sq) % 2 else 0.18
                    cr.set_source_rgb(g, g, g)
                    cr.rectangle(xx, yy, sq, sq)
                    cr.fill()
            return
        cr.set_source_rgb(*(int(c[k:k + 2], 16) / 255 for k in (1, 3, 5)))
        cr.rectangle(0, 0, w, h)
        cr.fill()

    def select_color(self, i):
        self.swatches[self.csel].remove_css_class("selected")
        self.csel = i
        self.swatches[i].add_css_class("selected")
        self.update_title()

    def mark_current_color(self):
        cur = current_waybar_color()
        for c, sw in zip(self.swatch_colors, self.swatches):
            if c == cur:
                sw.add_css_class("current")
            else:
                sw.remove_css_class("current")

    def apply_color(self, i):
        set_waybar_color(self.swatch_colors[i])
        self.mark_current_color()

    def click_swatch(self, i):
        self.focus_row(1)
        self.select_color(i)
        self.apply_color(i)

    # --- Live preview -----------------------------------------------------

    def schedule_live_preview(self):
        if self.preview_timer:
            GLib.source_remove(self.preview_timer)
        self.preview_timer = GLib.timeout_add(PREVIEW_DELAY_MS, self.live_preview)

    def live_preview(self):
        self.preview_timer = 0
        path = self.walls[self.sel]
        if path != self.shown:
            preview_wallpaper(path)
            self.shown = path
        return False

    def cancel_live_preview(self):
        if self.preview_timer:
            GLib.source_remove(self.preview_timer)
            self.preview_timer = 0

    # --- Finish -----------------------------------------------------------

    def apply(self, i):
        self.cancel_live_preview()
        set_wallpaper(self.walls[i])
        self.quit()

    def abort(self):
        self.cancel_live_preview()
        if self.original and self.shown != self.original:
            preview_wallpaper(self.original)
        self.quit()

    def on_key(self, _ctrl, keyval, _code, state):
        shift = state & Gdk.ModifierType.SHIFT_MASK
        name = Gdk.keyval_name(keyval)
        if name in ("Escape", "q"):
            self.abort()
        elif name in ("Return", "KP_Enter", "space"):
            if self.row_idx == 0:
                self.apply(self.sel)
            else:
                self.apply_color(self.csel)
        elif name in ("Down", "j"):
            self.focus_row(1)
        elif name in ("Up", "k"):
            self.focus_row(0)
        elif name == "ISO_Left_Tab" or (name == "Tab" and shift):
            self.move(-1)
        elif name in ("Tab", "Right", "l"):
            self.move(1)
        elif name in ("Left", "h"):
            self.move(-1)
        elif name in ("Home", "End"):
            n = len(self.items) if self.row_idx == 0 else len(self.swatches)
            self.move((0 if name == "Home" else n - 1) - (self.sel if self.row_idx == 0 else self.csel))
        else:
            return False
        return True


if __name__ == "__main__":
    sys.exit(Switcher().run(None))
