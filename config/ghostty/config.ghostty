theme = Black Metal (Venom)
# Must match OPACITY in sway/scripts/ghostty-walltheme
background-opacity = 0.35
background-blur = 20
font-family = BigBlueTerm437 Nerd Font Mono
font-size = 14
shell-integration = zsh
shell-integration-features = ssh-terminfo,ssh-env
undo-timeout = 15s
confirm-close-surface = false

# Colors generated from the wallpaper by ghostty-walltheme (bgswitch),
# not tracked by git. The theme above is the fallback when it's missing.
config-file = ?auto/theme.ghostty
