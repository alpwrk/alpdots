// Mono theme for rofi: dark grey surfaces, white accent.
// Same font as waybar/ghostty (BigBlueTerm), layout: prompt pill on top,
// single-column app list with icons, mode tabs along the bottom edge.

configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "󰀻 Apps";
    display-run: " Run";
    display-window: " Window";
    drun-display-format: "{name}";
}

// Color palette, fully opaque.
* {
    font: "BigBlueTermPlus Nerd Font 11";
    bg: #0d0d0d;
    bg-alt: #161616;
    surface: #1f1f1f;
    border: #2b2b2b;
    fg: #e6e6e6;
    muted: #8a8a8a;
    accent: #ffffff;
    urgent: #9a9a9a;
    transparent: #00000000;
    background-color: @transparent;
    text-color: @fg;
}

window {
    width: 480px;
    border: 2px;
    border-color: @border;
    border-radius: 0;
    background-color: @bg;
    padding: 0;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview, mode-switcher ];
}

// Only the search entry; the active mode is shown in the tab row below.
inputbar {
    spacing: 12px;
    padding: 18px 20px 10px 20px;
    children: [ entry ];
}

prompt {
    padding: 6px 12px;
    border: 1px;
    border-color: @border;
    border-radius: 0;
    background-color: @surface;
    text-color: @accent;
}

entry {
    vertical-align: 0.5;
    placeholder: "Search…";
    placeholder-color: @muted;
    text-color: @fg;
}

listview {
    columns: 1;
    lines: 8;
    // Shrink with fewer entries instead of keeping empty rows
    fixed-height: false;
    scrollbar: false;
    cycle: true;
    spacing: 2px;
    padding: 8px 20px 16px 20px;
}

element {
    padding: 8px 10px;
    spacing: 12px;
    border-radius: 0;
    children: [ element-icon, element-text ];
}

element normal.normal, element alternate.normal { background-color: @transparent; text-color: @fg; }
element selected.normal, element selected.active { background-color: @surface; text-color: @accent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }

element-icon { size: 20px; vertical-align: 0.5; background-color: inherit; }
element-text { vertical-align: 0.5; background-color: inherit; text-color: inherit; }

// Mode tabs flush with the bottom edge, like a tab strip.
mode-switcher {
    spacing: 0;
    background-color: @bg-alt;
}

button {
    padding: 12px;
    horizontal-align: 0.5;
    background-color: @bg-alt;
    text-color: @muted;
}

button selected {
    background-color: @surface;
    text-color: @accent;
}
