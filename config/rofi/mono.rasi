// Mono theme for rofi: dark grey surfaces, white accent, no icons anywhere.
// Goes with the waybar setup, same font, same idea.

configuration {
    modi: "drun,run,window";
    // Icons would break the text-only look
    show-icons: false;
    display-drun: " Apps";
    display-run: " Run";
    display-window: " Windows";
}

// Color palette. bg has a bit of transparency so the swayfx blur shows through.
* {
    font: "JetBrainsMono Nerd Font 10";
    bg: #0d0d0dcc;
    bg-alt: #161616;
    surface: #1f1f1f;
    border: #2b2b2b;
    fg: #e6e6e6;
    muted: #8a8a8a;
    accent: #ffffff;
    urgent: #9a9a9a;
    transparent: #00000000;
}

window {
    width: 680px;
    border: 2px;
    border-color: @border;
    border-radius: 2px;
    background-color: @bg;
    padding: 18px;
}

mainbox { spacing: 14px; background-color: @transparent; }

inputbar {
    spacing: 10px;
    padding: 12px 14px;
    border: 1px;
    border-color: @border;
    border-radius: 2px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; background-color: @transparent; }

entry {
    placeholder: "Search applications…";
    placeholder-color: @muted;
    text-color: @fg;
    background-color: @transparent;
}

listview {
    lines: 8;
    columns: 1;
    // Shrink with fewer entries instead of keeping empty rows
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
    background-color: @transparent;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 2px;
    background-color: @transparent;
    text-color: @fg;
}

element selected { background-color: @surface; text-color: @accent; }
element-text { vertical-align: 0.5; background-color: @transparent; text-color: inherit; }